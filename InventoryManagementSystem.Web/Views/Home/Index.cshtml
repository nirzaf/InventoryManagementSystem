@{
    ViewData["Title"] = "Dashboard";
}

<MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4">Dashboard</MudText>
<MudDivider Class="mb-4" />

<MudGrid>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Items</MudText>
            <MudText Typo="Typo.h3" Color="Color.Primary">@ViewBag.ItemCount</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Purchase Orders</MudText>
            <MudText Typo="Typo.h3" Color="Color.Success">@ViewBag.POCount</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Units in Stock</MudText>
            <MudText Typo="Typo.h3" Color="Color.Info">@ViewBag.StockItems</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudGrid Class="mt-4">
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1">
            <MudText Typo="Typo.subtitle1" Class="pa-3 mud-theme-secondary">Quick Actions</MudText>
            <MudDivider />
            <div class="pa-3">
                <div class="d-grid gap-2">
                    <a asp-controller="Items" asp-action="Create" class="mud-button mud-button-outlined mud-button-outlined-primary mud-width-full">Add New Item</a>
                    <a asp-controller="Stock" asp-action="Receive" class="mud-button mud-button-outlined mud-button-outlined-success mud-width-full">Receive Stock</a>
                    <a asp-controller="Suppliers" asp-action="Create" class="mud-button mud-button-outlined mud-button-outlined-info mud-width-full">Add New Supplier</a>
                </div>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1">
            <MudText Typo="Typo.subtitle1" Class="pa-3 mud-theme-secondary">Navigation</MudText>
            <MudDivider />
            <div class="pa-3">
                <div class="d-grid gap-2">
                    <a asp-controller="Items" asp-action="Index" class="mud-button mud-button-outlined mud-button-outlined-secondary mud-width-full">Manage Items</a>
                    <a asp-controller="Stock" asp-action="Index" class="mud-button mud-button-outlined mud-button-outlined-secondary mud-width-full">View Stock</a>
                    <a asp-controller="PurchaseOrders" asp-action="Index" class="mud-button mud-button-outlined mud-button-outlined-secondary mud-width-full">Purchase Orders</a>
                    <a asp-controller="Suppliers" asp-action="Index" class="mud-button mud-button-outlined mud-button-outlined-secondary mud-width-full">Manage Suppliers</a>
                    <a asp-controller="Locations" asp-action="Index" class="mud-button mud-button-outlined mud-button-outlined-secondary mud-width-full">Manage Locations</a>
                </div>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>
