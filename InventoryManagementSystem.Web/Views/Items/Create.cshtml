@model InventoryManagementSystem.Core.Entities.Item
@{
    ViewData["Title"] = "Create Item";
}

<MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-3">Create Item</MudText>
<MudDivider Class="mb-4" />

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1" Class="pa-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mud-text-error mb-3"></div>
                <div class="mb-3">
                    <label asp-for="ItemCode" class="mud-input-label mud-input-label-text"></label>
                    <input asp-for="ItemCode" class="mud-input mud-input-outlined mud-input-text mud-width-full" required />
                    <span asp-validation-for="ItemCode" class="mud-text-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="mud-input-label mud-input-label-text"></label>
                    <input asp-for="Description" class="mud-input mud-input-outlined mud-input-text mud-width-full" required />
                    <span asp-validation-for="Description" class="mud-text-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Rate" class="mud-input-label mud-input-label-text"></label>
                    <input asp-for="Rate" class="mud-input mud-input-outlined mud-input-text mud-width-full" type="number" step="0.01" required />
                    <span asp-validation-for="Rate" class="mud-text-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="SupplierId" class="mud-input-label mud-input-label-text">Supplier</label>
                    <select asp-for="SupplierId" class="mud-select mud-width-full">
                        <option value="">-- Select Supplier --</option>
                        @foreach (var supplier in ViewBag.Suppliers)
                        {
                            <option value="@supplier.Id">@supplier.Name</option>
                        }
                    </select>
                </div>
                <div style="display:flex; gap:8px;">
                    <button type="submit" class="mud-button mud-button-filled mud-button-filled-primary">Create</button>
                    <a asp-action="Index" class="mud-button mud-button-outlined mud-button-outlined-secondary">Cancel</a>
                </div>
            </form>
        </MudPaper>
    </MudItem>
</MudGrid>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
