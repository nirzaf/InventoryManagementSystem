@model IEnumerable<InventoryManagementSystem.Core.Entities.Item>
@{
    ViewData["Title"] = "Items";
}

<div style="display:flex; justify-content:space-between; align-items:center;" class="mb-3">
    <MudText Typo="Typo.h4" Color="Color.Primary">Items</MudText>
    <a asp-action="Create" class="mud-button mud-button-filled mud-button-filled-primary">Add New Item</a>
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div style="display:flex; gap:8px;">
        <input type="text" name="search" class="mud-input mud-input-outlined mud-input-text"
               placeholder="Search by code or description..." value="@ViewBag.Search"
               style="flex:1; padding:12px;" />
        <button type="submit" class="mud-button mud-button-outlined mud-button-outlined-secondary">Search</button>
    </div>
</form>

<MudPaper Elevation="1">
    <table class="mud-table mud-table-striped mud-table-hover mud-width-full">
        <thead class="mud-table-head mud-theme-primary">
            <tr>
                <th class="mud-table-cell">Item Code</th>
                <th class="mud-table-cell">Description</th>
                <th class="mud-table-cell">Rate</th>
                <th class="mud-table-cell">Supplier</th>
                <th class="mud-table-cell mud-table-cell-right">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr class="mud-table-row">
                    <td class="mud-table-cell" colspan="5">
                        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="pa-3">No items found.</MudText>
                    </td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr class="mud-table-row">
                    <td class="mud-table-cell">@item.ItemCode</td>
                    <td class="mud-table-cell">@item.Description</td>
                    <td class="mud-table-cell">@item.Rate.ToString("C")</td>
                    <td class="mud-table-cell">@item.Supplier?.Name</td>
                    <td class="mud-table-cell mud-table-cell-right">
                        <a asp-action="Details" asp-route-id="@item.Id" class="mud-button mud-button-outlined mud-button-outlined-info mud-button-small">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="mud-button mud-button-outlined mud-button-outlined-warning mud-button-small">Edit</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline-block;"
                              onsubmit="return confirm('Delete this item?')">
                            <button type="submit" class="mud-button mud-button-outlined mud-button-outlined-error mud-button-small">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</MudPaper>
