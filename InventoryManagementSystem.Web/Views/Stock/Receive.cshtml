@{
    ViewData["Title"] = "Receive Stock";
}

<MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-3">Receive Stock</MudText>
<MudDivider Class="mb-4" />

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1" Class="pa-4">
            <form asp-action="Receive" method="post">
                <div class="mb-3">
                    <label class="mud-input-label mud-input-label-text">Item</label>
                    <select name="itemId" class="mud-select mud-width-full" required>
                        <option value="">-- Select Item --</option>
                        @foreach (var item in ViewBag.Items)
                        {
                            <option value="@item.Id">@item.ItemCode - @item.Description</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="mud-input-label mud-input-label-text">Location</label>
                    <select name="locationId" class="mud-select mud-width-full" required>
                        <option value="">-- Select Location --</option>
                        @foreach (var loc in ViewBag.Locations)
                        {
                            <option value="@loc.Id">@loc.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="mud-input-label mud-input-label-text">Quantity</label>
                    <input name="quantity" type="number" class="mud-input mud-input-outlined mud-input-text mud-width-full" min="1" required />
                </div>
                <div class="mb-3">
                    <label class="mud-input-label mud-input-label-text">Notes</label>
                    <textarea name="notes" class="mud-input mud-input-outlined mud-input-text mud-width-full" rows="2"></textarea>
                </div>
                <div style="display:flex; gap:8px;">
                    <button type="submit" class="mud-button mud-button-filled mud-button-filled-success">Receive Stock</button>
                    <a asp-action="Index" class="mud-button mud-button-outlined mud-button-outlined-secondary">Cancel</a>
                </div>
            </form>
        </MudPaper>
    </MudItem>
</MudGrid>
