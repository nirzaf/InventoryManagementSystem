@model IEnumerable<InventoryManagementSystem.Core.Entities.StockInHand>
@{
    ViewData["Title"] = "Stock Overview";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Stock Overview</h2>
    <div>
        <a asp-action="Receive" class="btn btn-success">Receive Stock</a>
        <a asp-action="Transfer" class="btn btn-info">Transfer Stock</a>
        <a asp-action="Sell" class="btn btn-warning">Sell Stock</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Item Code</th>
                    <th>Description</th>
                    <th>Location</th>
                    <th class="text-end">Quantity</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-3">No stock records.</td></tr>
                }
                @foreach (var stock in Model)
                {
                    <tr>
                        <td>@stock.Item?.ItemCode</td>
                        <td>@stock.Item?.Description</td>
                        <td>@stock.Location?.Name</td>
                        <td class="text-end">@stock.Quantity</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
