@model IEnumerable<InventoryManagementSystem.Core.Entities.StockInHand>
@{
    ViewData["Title"] = "Stock Overview";
}

<div style="display:flex; justify-content:space-between; align-items:center;" class="mb-3">
    <MudText Typo="Typo.h4" Color="Color.Primary">Stock Overview</MudText>
    <div style="display:flex; gap:8px;">
        <a asp-action="Receive" class="mud-button mud-button-filled mud-button-filled-success">Receive Stock</a>
        <a asp-action="Transfer" class="mud-button mud-button-filled mud-button-filled-info">Transfer Stock</a>
        <a asp-action="Sell" class="mud-button mud-button-filled mud-button-filled-warning">Sell Stock</a>
    </div>
</div>

<MudPaper Elevation="1">
    <table class="mud-table mud-table-striped mud-table-hover mud-width-full">
        <thead class="mud-table-head mud-theme-primary">
            <tr>
                <th class="mud-table-cell">Item Code</th>
                <th class="mud-table-cell">Description</th>
                <th class="mud-table-cell">Location</th>
                <th class="mud-table-cell mud-table-cell-right">Quantity</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr class="mud-table-row">
                    <td class="mud-table-cell" colspan="4">
                        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="pa-3">No stock records.</MudText>
                    </td>
                </tr>
            }
            @foreach (var stock in Model)
            {
                <tr class="mud-table-row">
                    <td class="mud-table-cell">@stock.Item?.ItemCode</td>
                    <td class="mud-table-cell">@stock.Item?.Description</td>
                    <td class="mud-table-cell">@stock.Location?.Name</td>
                    <td class="mud-table-cell mud-table-cell-right">@stock.Quantity</td>
                </tr>
            }
        </tbody>
    </table>
</MudPaper>
