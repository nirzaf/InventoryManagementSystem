@model IEnumerable<InventoryManagementSystem.Core.Entities.StockTransaction>
@{
    ViewData["Title"] = "Stock Transactions";
}

<h2>Stock Transactions</h2>
<hr />

<form asp-action="Transactions" method="get" class="mb-3 row g-2">
    <div class="col-auto">
        <label class="form-label">From</label>
        <input type="date" name="from" class="form-control" value="@Context.Request.Query["from"]" />
    </div>
    <div class="col-auto">
        <label class="form-label">To</label>
        <input type="date" name="to" class="form-control" value="@Context.Request.Query["to"]" />
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">Filter</button>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Item Code</th>
                    <th>From</th>
                    <th>To</th>
                    <th class="text-end">Qty</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-3">No transactions found.</td></tr>
                }
                @foreach (var tx in Model)
                {
                    <tr>
                        <td>@tx.TransactionDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="badge bg-@(tx.TransactionType == "Receive" ? "success" : tx.TransactionType == "Transfer" ? "info" : "warning")">@tx.TransactionType</span></td>
                        <td>@tx.Item?.ItemCode</td>
                        <td>@tx.FromLocation?.Name</td>
                        <td>@tx.ToLocation?.Name</td>
                        <td class="text-end">@tx.Quantity</td>
                        <td>@tx.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
