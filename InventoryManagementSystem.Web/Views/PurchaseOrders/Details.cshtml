@model InventoryManagementSystem.Core.Entities.PurchaseOrder
@{
    ViewData["Title"] = "Purchase Order Details";
}

<h2>PO #@Model.PONumber</h2>
<hr />

<div class="row mb-4">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Date</dt>
            <dd class="col-sm-8">@Model.OrderDate.ToString("yyyy-MM-dd")</dd>
            <dt class="col-sm-4">Supplier</dt>
            <dd class="col-sm-8">@Model.Supplier?.Name</dd>
            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8"><span class="badge bg-@(Model.Status == InventoryManagementSystem.Core.Entities.PurchaseOrderStatus.Pending ? "warning" : "success")">@Model.Status</span></dd>
            <dt class="col-sm-4">Total</dt>
            <dd class="col-sm-8">@Model.TotalAmount.ToString("C")</dd>
        </dl>
    </div>
    <div class="col-md-6 text-end">
        @if (Model.Status == InventoryManagementSystem.Core.Entities.PurchaseOrderStatus.Pending)
        {
            <form asp-action="UpdateStatus" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="Approved" />
                <button type="submit" class="btn btn-success">Approve</button>
            </form>
        }
    </div>
</div>

<h4>Line Items</h4>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Item Code</th>
                    <th>Description</th>
                    <th class="text-end">Qty</th>
                    <th class="text-end">Unit Price</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.OrderDetails.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-3">No line items.</td></tr>
                }
                @foreach (var d in Model.OrderDetails)
                {
                    <tr>
                        <td>@d.Item?.ItemCode</td>
                        <td>@d.Item?.Description</td>
                        <td class="text-end">@d.Quantity</td>
                        <td class="text-end">@d.UnitPrice.ToString("C")</td>
                        <td class="text-end">@d.TotalPrice.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<p class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</p>
