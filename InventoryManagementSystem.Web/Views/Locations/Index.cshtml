@model IEnumerable<InventoryManagementSystem.Core.Entities.Location>
@{
    ViewData["Title"] = "Locations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Locations</h2>
    <a asp-action="Create" class="btn btn-primary">Add New Location</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Address</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="3" class="text-center text-muted py-3">No locations found.</td></tr>
                }
                @foreach (var l in Model)
                {
                    <tr>
                        <td>@l.Name</td>
                        <td>@l.Address</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@l.Id" class="btn btn-sm btn-warning">Edit</a>
                            <form asp-action="Delete" asp-route-id="@l.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this location?')">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
